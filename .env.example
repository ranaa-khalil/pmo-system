# PMO System — Environment Configuration
# Copy this file to .env and fill in your values

# Environment: development, staging, production
PMO_ENV=development

# Database — PostgreSQL (default), SQLite for tests/local dev
# PostgreSQL (Docker):  PMO_DATABASE_URL=postgresql://pmo:pmo_pass@localhost:5432/pmo_system
# SQLite (no Docker):    PMO_DATABASE_URL=sqlite:///./pmo_system.db
PMO_DATABASE_URL=postgresql://pmo:pmo_pass@localhost:5432/pmo_system

# Auth
PMO_SECRET_KEY=change-this-to-a-random-secret-key
PMO_DEBUG=true

# GitHub integration (optional)
PMO_GITHUB_TOKEN=

# AI/LLM integration (optional)
PMO_AI_API_KEY=
PMO_AI_BASE_URL=https://api.openai.com/v1
PMO_AI_MODEL=gpt-4o-mini

# Email (optional)
PMO_SMTP_HOST=
PMO_SMTP_PORT=587
PMO_SMTP_USER=
PMO_SMTP_PASSWORD=
PMO_EMAIL_FROM=noreply@pmosystem.app

# Sentry error tracking (optional)
PMO_SENTRY_DSN=

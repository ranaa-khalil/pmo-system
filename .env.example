# PMO System — Environment Configuration
# Copy this file to .env and fill in your values.
# Generate a secret key: python -c "import secrets; print(secrets.token_hex(32))"

# ── Core ────────────────────────────────────────────────────────────────
# Environment: development, staging, production
PMO_ENV=production
# Set to false in production
PMO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PMO_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-HEX-STRING
# Base URL of the app (used for password reset links, emails)
PMO_APP_URL=https://pmo-system.obelion.ai

# ── Database ────────────────────────────────────────────────────────────
# Used by Docker Compose
PMO_POSTGRES_USER=pmo
PMO_POSTGRES_PASSWORD=change-this-to-a-strong-password
PMO_POSTGRES_DB=pmo_system
# Connection string (if not using Docker Compose networking)
PMO_DATABASE_URL=postgresql://pmo:change-this@db:5432/pmo_system

# ── Infrastructure Encryption ───────────────────────────────────────────
# Used to encrypt stored secrets (infrastructure module)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INFRA_ENCRYPTION_KEY=CHANGE-ME-FERNET-KEY

# ── Email (Resend API — preferred) ──────────────────────────────────────
# Get a free key at https://resend.com
PMO_RESEND_API_KEY=
# On Resend free tier, FROM must be onboarding@resend.dev
# After verifying your domain, use: PMO System <noreply@obelion.ai>
PMO_EMAIL_FROM=PMO System <onboarding@resend.dev>

# ── Email (SMTP fallback — optional) ────────────────────────────────────
PMO_SMTP_HOST=
PMO_SMTP_PORT=587
PMO_SMTP_USER=
PMO_SMTP_PASSWORD=

# ── GitHub Integration (optional) ───────────────────────────────────────
PMO_GITHUB_TOKEN=

# ── AI/LLM Integration (optional) ───────────────────────────────────────
PMO_AI_API_KEY=
PMO_AI_BASE_URL=https://api.openai.com/v1
PMO_AI_MODEL=gpt-4o-mini

# ── Sentry Error Tracking (optional) ────────────────────────────────────
PMO_SENTRY_DSN=
